vsi {{ vsi_name }}
  gateway vsi-interface {{ vsi_interface_id }}
  #
  evpn encapsulation vxlan
  vxlan vni {{ vni }}
  vxlan local-arp enable
!
interface Vsi-interface{{ vsi_interface_id }}
  ip address {{ vsi_interface_ip }}
!
bgp {{ local_asn }}
{% for peer in vtep_peers %}
  peer {{ peer.address }} as-number {{ peer.remote_asn }}
  peer {{ peer.address }} connect-interface LoopBack0
{% endfor %}
  address-family l2vpn evpn
{% for peer in vtep_peers %}
    peer {{ peer.address }} enable
{% endfor %}
