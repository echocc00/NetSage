# ===== 应用 =====
ENV=dev
LOG_LEVEL=INFO

# ===== 数据库 =====
POSTGRES_USER=netsage
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=netsage
DATABASE_URL=postgresql+asyncpg://netsage:changeme_dev_only@localhost:5432/netsage

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Vault（可选，开发态可留空走本地凭证） =====
VAULT_ADDR=
VAULT_TOKEN=

# ===== LLM 网关（LiteLLM） =====
LITELLM_MASTER_KEY=changeme_dev_only
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# MiniMax（用户后续提供 key，缺失时 LLM 网关降级到其他模型）
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.chat/v1
# 默认模型路由
LLM_DEFAULT_MODEL=deepseek/deepseek-chat
LLM_FALLBACK_MODEL=minimax/abab6.5s-chat
LLM_REASONING_MODEL=deepseek/deepseek-reasoner

# ===== MCP Server 端点 =====
MCP_CONTAINERLAB_URL=http://localhost:9001
MCP_BATFISH_URL=http://localhost:9002
MCP_NAPALM_URL=http://localhost:9003

# ===== 仿真环境 =====
CONTAINERLAB_HOST=
BATFISH_HOST=http://localhost:9996

# ===== 脱敏 =====
REDACT_BLACKBOX_LOCAL_ONLY=true

# ===== OIDC / SSO（Keycloak E2E，v0.5.0） =====
# 先起实例 + provision：
#   docker compose -f infra/docker-compose.keycloak.yml up -d
#   python backend/scripts/provision_keycloak.py     → 生成 .env.keycloak
# 未配置时 /auth/oidc 降级 503，开发用 /auth/dev-token。
OIDC_DISCOVERY_URL=http://localhost:9090/realms/netsage
OIDC_CLIENT_ID=netsage-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_BASE=http://localhost:8000
# 多租户 IdP 覆盖（可选；tenant slug → 各自的 discovery/client/secret）
# 需与全局默认并存：OIDC_DISCOVERY_URL 仍是 default 租户的 IdP。
# 未在 OIDC_TENANTS 的租户会回退到 default IdP。
# OIDC_TENANTS='{"acme":{"discovery_url":"https://idp.acme.example/realms/acme","client_id":"acme-web","client_secret":"..."}}'

# ===== 生产部署（infra/docker-compose.prod.yml） =====
# Nautobot mock 开关：true = 用内置 mock 数据源（无真实 Nautobot 接入时）；
# 接真实 Nautobot 时在 .env 覆盖为 false，compose 里经 ${NAUTOBOT_MOCK:-true} 透传
NAUTOBOT_MOCK=true
# 后端端口绑定地址（compose ports 的 host 侧）：默认仅绑定本机回环；
# 需要从外部直连后端时改为 0.0.0.0（生产建议保持回环 + 由前端/反代转发）
BACKEND_BIND=127.0.0.1

# ===== 工具链模式（v0.5.0 三道闸接线） =====
# mock = 演示预设（闸门必过，仅联调；API 响应 tools_mode=mock 明示）
# mcp  = 经 HttpToolRegistry 调真实 MCP server（containerlab/batfish/napalm/...）
#        需先起对应 server（见 mcp-servers/ 各目录），默认端口 9001-9007
TOOLS_BACKEND=mock
# MCP server 端点（TOOLS_BACKEND=mcp 时生效；下面是默认值，按需覆盖）
# MCP_CONTAINERLAB_URL=http://localhost:9001
# MCP_BATFISH_URL=http://localhost:9002
# MCP_NAPALM_URL=http://localhost:9003
# MCP_NETBOX_URL=http://localhost:9004
# MCP_SUZIEQ_URL=http://localhost:9005
# MCP_OPENSM_URL=http://localhost:9006
# MCP_NAUTOBOT_URL=http://localhost:9007
