# ===== 应用 =====
ENV=dev
LOG_LEVEL=INFO

# ===== 数据库 =====
POSTGRES_USER=netsage
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=netsage
DATABASE_URL=postgresql+asyncpg://netsage:changeme_dev_only@localhost:5432/netsage

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Vault（可选，开发态可留空走本地凭证） =====
VAULT_ADDR=
VAULT_TOKEN=

# ===== LLM 网关（LiteLLM） =====
LITELLM_MASTER_KEY=changeme_dev_only
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# MiniMax（用户后续提供 key，缺失时 LLM 网关降级到其他模型）
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.chat/v1
# 默认模型路由
LLM_DEFAULT_MODEL=deepseek/deepseek-chat
LLM_FALLBACK_MODEL=minimax/abab6.5s-chat
LLM_REASONING_MODEL=deepseek/deepseek-reasoner

# ===== MCP Server 端点 =====
MCP_CONTAINERLAB_URL=http://localhost:9001
MCP_BATFISH_URL=http://localhost:9002
MCP_NAPALM_URL=http://localhost:9003

# ===== 仿真环境 =====
CONTAINERLAB_HOST=
BATFISH_HOST=http://localhost:9996

# ===== 脱敏 =====
REDACT_BLACKBOX_LOCAL_ONLY=true
